#!/bin/sh
#
# ╔════════════════════════════════════╗
# ║                                    ║
# ║    ██████  ████████   █████ █████  ║
# ║   ███░░███░░███░░███ ░░███ ░░███   ║
# ║  ░███████  ░███ ░███  ░███  ░███   ║
# ║  ░███░░░   ░███ ░███  ░░███ ███    ║
# ║  ░░██████  ████ █████  ░░█████     ║
# ║   ░░░░░░  ░░░░ ░░░░░    ░░░░░      ║
# ║                                    ║
# ╚════════════════════════════════════╝
#

# set up common environment

PATH="$HOME/bin:$HOME/.local/bin:/opt/local/sbin:/opt/local/bin:$PATH"
PATH="$PATH:$HOME/bin/$(uname -m)"
export PATH

# set up MANPATH for pkgsrc, if we are on some kind of Solaris/Illumos
if [ "$(uname)" = "SunOS" ] ; then
	export MANPATH="/opt/local/man:/usr/share/man:$MANPATH"
fi

# setup kakoune as default editor, vi as fallback
if command -v kak >/dev/null; then
	export EDITOR=kak
	export VISUAL=kak
elif command -v vi >/dev/null; then
	export EDITOR=vi
	export VISUAL=vi
fi

if command -v less >/dev/null; then
	export PAGER=less
fi

if command -v alacritty >/dev/null; then
	export TERMINAL=alacritty
elif command -v qterminal >/dev/null; then
	export TERMINAL=qterminal
elif command -v konsole >/dev/null; then
	export TERMINAL=konsole
elif command -v xterm >/dev/null; then
	export TERMINAL=xterm
fi

if command -v doas >/dev/null; then
	export PRIV_ESC=doas
elif command -v pfexec >/dev/null; then
	export PRIV_ESC=pfexec
elif command -v sudo >/dev/null; then
	export PRIV_ESC=sudo
fi

if command -v elinks >/dev/null; then
	export TUI_BROWSER=elinks
fi
