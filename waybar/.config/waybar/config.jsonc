{
    "layer": "bottom",
    "position": "top",
    "output": ["DP-2"],
    "height": 40,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode", "wlr/taskbar"],
    "modules-right": ["tray", "clock"],

    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "{}"
    },

    "wlr/taskbar": {
        "all-outputs": true,
        "format": "{icon} {title:.20}",
        "icon-size": 24,
        "icon-theme": "BesotHaiku",
        "on-click": "activate",
        "on-click-middle": "close",
        "truncate": true,
        "expand": true,
    },

    "sway/window": {
        "format": "{}",
        "max-length": 60
    },

    "tray": {
        "icon-size": 24,
        "spacing": 8
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d.%m.%Y}"
    }
}
