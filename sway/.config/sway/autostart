# bar
exec_always "pkill waybar ; waybar &"

# desktop widget
exec_always "pkill nwg-wrapper ; nwg-wrapper -s ~/bin/wonky.sh -p left -a start -ml 50 -mt 50 -mb 50 -r 1000 -j center -o DP-2 &"

# screen filter
exec gammastep -l 51.3:12.4 &

# automatic screen brightness
exec wluma &

# screen lock & inactivity handling
exec_always pkill swayidle ; swayidle -w \
		before-sleep lock.sh \
		timeout 900 'loginctl sleep'
exec sway-audio-idle-inhibit

# notifications
exec dunst &

# low battery warning
exec batsignal -b

# import environment to dbus for screensharing
#exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway QT_QPA_PLATFORMTHEME
exec dbus-update-activation-environment --systemd --all

# run pcmanfm-qt in daemon mode
exec pcmanfm-qt -d

# run pipewire
exec pipewire &

# run easyeffects
exec easyeffects --hide-window &

